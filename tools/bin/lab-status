#!/usr/bin/env python3
import os
import sys

# 將 lib 目錄加入 sys.path
BASE_DIR = os.path.dirname(os.path.realpath(__file__))
LIB_DIR = os.path.abspath(os.path.join(BASE_DIR, "..", "lib"))
if LIB_DIR not in sys.path:
    sys.path.insert(0, LIB_DIR)

from lab_status import main

if __name__ == "__main__":
    main()
