#!/usr/bin/env bash
# ==============================================================================
# Atomic Test Helper: Execute Dagger Container Pipeline Verification
# File: tests/bin/test-dagger-e2e
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

TEST_LANG="${LAB_LANG:-${LAB_LANG:-en_US}}"
export LAB_LANG="${TEST_LANG}"
export LAB_LANG="${TEST_LANG}"

echo "[•] Executing Dagger E2E pipeline (${REPO_ROOT}/tests/e2e/test_dagger.py, Locale: ${TEST_LANG})..."
python3 "${REPO_ROOT}/tests/e2e/test_dagger.py"
echo "[✓] Dagger E2E verification passed successfully!"

