#!/usr/bin/env bash
# ==============================================================================
# Atomic Test Helper: Execute Disaster Recovery (DR) Backup & Restore Drill
# File: tests/bin/test-dr-drill
# Governed by [INV-09] (Production Tooling & Verification Contract)
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
PROJECT_NAME="$(basename "${REPO_ROOT}")"

TARGET_NODES="${1:-mock-arch,mock-photon,mock-debian}"

echo "[•] Triggering Automated Disaster Recovery (DR) Drill on target [${TARGET_NODES}] inside mock-console as user labadmin..."
docker exec -e PROJECT_NAME="${PROJECT_NAME}" -u labadmin mock-console bash -c "
cd /home/labadmin/${PROJECT_NAME}
bash tests/sandbox/dr_drill.sh '${TARGET_NODES}'
"
echo "[✓] Automated Disaster Recovery (DR) Drill completed successfully!"
