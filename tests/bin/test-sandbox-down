#!/usr/bin/env bash
# ==============================================================================
# Atomic Test Helper: Teardown Sandbox Container Fleet and Volumes
# File: tests/bin/test-sandbox-down
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
COMPOSE_FILE="${REPO_ROOT}/tests/sandbox/docker-compose.yml"

echo "[•] Tearing down sandbox containers and cleaning up volumes..."
docker rm -f mock-node-gitea 2>/dev/null || true
docker compose -f "${COMPOSE_FILE}" down -v
echo "[✓] Sandbox test fleet completely destroyed and cleaned up."

