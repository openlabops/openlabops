---
# ==============================================================================
# 全域通用變數 (Global Group Vars for All Hosts)
# Auto-generated by openlabops from manifest
# ==============================================================================
ansible_user: {{ cluster.ansible_user }}
admin_user: {{ cluster.admin_user }}
ansible_ssh_private_key_file: "{% raw %}{{ lookup('env', 'HOME') }}{% endraw %}/.ssh/{{ keys.ansible | default(cluster.ansible_user + '.key') }}"

# 規範中性金鑰網段存取限制 (Canonical Key Network Constraints)
ansible_key_options: 'from="{{ networks.service_lan }}"'
user_key_options: 'from="{{ networks.service_lan }}{% if networks.user_lan is defined and networks.user_lan != networks.service_lan %},{{ networks.user_lan }}{% endif %}"'
endpoint_key_options: ""

{% if git_platform.repo_prefix is defined and git_platform.repo_prefix != 'openlab' %}
# 向後相容別名 (Legacy Key Option Aliases)
ansible_key_options: 'from="{{ networks.service_lan }}"'
user_key_options: 'from="{{ networks.service_lan }}{% if networks.user_lan is defined and networks.user_lan != networks.service_lan %},{{ networks.user_lan }}{% endif %}"'
{% endif %}

# 叢集網段定義與允許來源
cluster_subnets:
  - "{{ networks.service_lan }}"
{%- if networks.openlab_mesh is defined %}
  - "{{ networks.openlab_mesh }}"
{%- endif %}
allowed_ssh_cidrs: "{{ networks.service_lan }}{% if networks.user_lan is defined %},{{ networks.user_lan }}{% endif %}{% if networks.openlab_mesh is defined %},{{ networks.openlab_mesh }}{% endif %}"
{% if git_platform.repo_prefix is defined and git_platform.repo_prefix != 'openlab' %}
openlab_subnets:
  - "{{ networks.service_lan }}"
{%- if networks.openlab_mesh is defined %}
  - "{{ networks.openlab_mesh }}"
{%- endif %}
{% endif %}

# 時區與語系設定
global_timezone: "{{ cluster.timezone }}"
global_locale: "{{ cluster.locale }}"

# 基礎套件清單
common_packages:
  - curl
  - wget
  - git
  - rsync
  - htop
  - vim
