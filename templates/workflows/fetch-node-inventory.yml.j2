name: Fetch Node Inventory Ground Truth

on:
  workflow_dispatch:

jobs:
  fetch-node-inventory:
    runs-on: ansible
    defaults:
      run:
        shell: sh

    steps:
      - name: 檢出工作流倉庫 (Self Checkout)
        run: |
          if ! command -v git >/dev/null 2>&1; then
            if command -v apk >/dev/null 2>&1; then apk add --no-cache git; elif command -v apt-get >/dev/null 2>&1; then apt-get update -qq && apt-get install -y -qq git; fi
          fi
          git clone --quiet --depth 1 http://oauth2:${{ '{' }}{{ '{' }} secrets.MASTER_TOKEN || secrets.BOT_TOKEN {{ '}' }}{{ '}' }}@${{ '{' }}{{ '{' }} vars.GIT_HOST || '{{ git_platform.host }}' {{ '}' }}{{ '}' }}/${{ '{' }}{{ '{' }} vars.ORG_NAME || '{{ git_platform.org }}' {{ '}' }}{{ '}' }}/{{ git_platform.repo_prefix }}-workflows.git .

      - name: 準備基礎環境
        uses: ./.gitea/actions/setup-environment
        with:
          packages: "git python3"

      - name: 檢出聯邦節點事實倉庫
        uses: ./.gitea/actions/checkout-federation
        with:
          repos: "{{ git_platform.repo_prefix }}-configs {{ git_platform.repo_prefix }}-operations"
          gitea_host: ${{ '{' }}{{ '{' }} vars.GIT_HOST || '{{ git_platform.host }}' {{ '}' }}{{ '}' }}
          org_name: ${{ '{' }}{{ '{' }} vars.ORG_NAME || '{{ git_platform.org }}' {{ '}' }}{{ '}' }}
          token: ${{ '{' }}{{ '{' }} secrets.MASTER_TOKEN || secrets.BOT_TOKEN {{ '}' }}{{ '}' }}

      - name: 聚合並輸出節點事實 JSON
        run: |
          python3 - <<'PY'
          import json
          from pathlib import Path

          nodes = {}
          cfg_dir = Path("/tmp/{{ git_platform.repo_prefix }}-configs/node-information")
          if cfg_dir.exists():
              for p in sorted(cfg_dir.glob("node_*.json")):
                  try:
                      d = json.loads(p.read_text(encoding="utf-8"))
                      h = d.get("hostname") or p.stem[5:]
                      nodes[h] = d
                  except Exception:
                      pass

          ops_dir = Path("/tmp/{{ git_platform.repo_prefix }}-operations/conf/nodes")
          if ops_dir.exists():
              for p in sorted(ops_dir.glob("*.json")):
                  if p.name == "current.json":
                      continue
                  try:
                      d = json.loads(p.read_text(encoding="utf-8"))
                      h = d.get("hostname") or p.stem
                      if h not in nodes:
                          nodes[h] = d
                  except Exception:
                      pass

          print("===OPENLAB_NODE_LIST_START===")
          print(json.dumps(list(nodes.values()), ensure_ascii=False))
          print("===OPENLAB_NODE_LIST_END===")
          PY
