name: Audit & Clean Authorized Keys Workflow

on:
  workflow_dispatch:
    inputs:
      target_hosts:
        description: 'Target Host(s) or Group (e.g., all, servers, dev)'
        required: false
        default: 'all'
      dry_run:
        description: 'Dry-run audit only without modifying authorized_keys (true/false)'
        required: false
        default: 'true'

jobs:
  clean-authorized-keys:
    runs-on: ansible
    defaults:
      run:
        shell: sh

    steps:
      - name: 檢出工作流倉庫 (Self Checkout)
        run: |
          if ! command -v git >/dev/null 2>&1; then
            if command -v apk >/dev/null 2>&1; then apk add --no-cache git; elif command -v apt-get >/dev/null 2>&1; then apt-get update -qq && apt-get install -y -qq git; fi
          fi
          git clone --quiet --depth 1 http://oauth2:${{ '{' }}{{ '{' }} secrets.MASTER_TOKEN || secrets.BOT_TOKEN {{ '}' }}{{ '}' }}@${{ '{' }}{{ '{' }} vars.GIT_HOST || '{{ git_platform.host }}' {{ '}' }}{{ '}' }}/${{ '{' }}{{ '{' }} vars.ORG_NAME || '{{ git_platform.org }}' {{ '}' }}{{ '}' }}/{{ git_platform.repo_prefix }}-workflows.git .

      - name: 執行 authorized_keys 稽核與清理劇本
        uses: ./.gitea/actions/execute-federation-playbook
        with:
          playbook: 'playbooks/clean-authorized-keys.yml'
          extra_vars: "target_hosts=${{ '{' }}{{ '{' }} inputs.target_hosts || 'all' {{ '}' }}{{ '}' }} dry_run=${{ '{' }}{{ '{' }} inputs.dry_run || 'true' {{ '}' }}{{ '}' }}"
          need_configs: 'false'
          key_name: '{{ keys.ansible | default("ansible.key") }}'
          gitea_host: ${{ '{' }}{{ '{' }} vars.GIT_HOST || '{{ git_platform.host }}' {{ '}' }}{{ '}' }}
          org_name: ${{ '{' }}{{ '{' }} vars.ORG_NAME || '{{ git_platform.org }}' {{ '}' }}{{ '}' }}
          token: ${{ '{' }}{{ '{' }} secrets.MASTER_TOKEN || secrets.BOT_TOKEN {{ '}' }}{{ '}' }}
