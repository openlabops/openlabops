name: Revoke Generic Host SSH Key Workflow ($hostname.pub)

on:
  workflow_dispatch:
    inputs:
      host_name:
        description: 'Endpoint Host Name to revoke (e.g., workstation, laptop, desktop)'
        required: true
      purge_secrets:
        description: 'Purge public key file from secrets repository? (true/false)'
        required: false
        default: 'true'

jobs:
  revoke-host-key:
    runs-on: ansible
    defaults:
      run:
        shell: sh

    steps:
      - name: 檢出工作流倉庫 (Self Checkout)
        run: |
          if ! command -v git >/dev/null 2>&1; then
            if command -v apk >/dev/null 2>&1; then apk add --no-cache git; elif command -v apt-get >/dev/null 2>&1; then apt-get update -qq && apt-get install -y -qq git; fi
          fi
          git clone --quiet --depth 1 http://oauth2:${{ '{' }}{{ '{' }} secrets.MASTER_TOKEN || secrets.BOT_TOKEN {{ '}' }}{{ '}' }}@${{ '{' }}{{ '{' }} vars.GIT_HOST || '{{ git_platform.host }}' {{ '}' }}{{ '}' }}/${{ '{' }}{{ '{' }} vars.ORG_NAME || '{{ git_platform.org }}' {{ '}' }}{{ '}' }}/{{ git_platform.repo_prefix }}-workflows.git .

      - name: 執行金鑰撤銷劇本
        uses: ./.gitea/actions/execute-homelab-playbook
        with:
          playbook: 'playbooks/revoke-host-key.yml'
          extra_vars: "host_name=${{ '{' }}{{ '{' }} inputs.host_name {{ '}' }}{{ '}' }} host_pub_key_path=/tmp/{{ git_platform.repo_prefix }}-secrets/ssh-key/${{ '{' }}{{ '{' }} inputs.host_name {{ '}' }}{{ '}' }}.pub"
          key_name: '{{ keys.ansible | default("ansible.key") }}'
          gitea_host: ${{ '{' }}{{ '{' }} vars.GIT_HOST || '{{ git_platform.host }}' {{ '}' }}{{ '}' }}
          org_name: ${{ '{' }}{{ '{' }} vars.ORG_NAME || '{{ git_platform.org }}' {{ '}' }}{{ '}' }}
          token: ${{ '{' }}{{ '{' }} secrets.MASTER_TOKEN || secrets.BOT_TOKEN {{ '}' }}{{ '}' }}

      - name: 若指定清除倉庫記錄，自 Secrets 移除並提交
        if: ${{ '{' }}{{ '{' }} inputs.purge_secrets == 'true' {{ '}' }}{{ '}' }}
        shell: sh
        env:
          HOST_NAME: ${{ '{' }}{{ '{' }} inputs.host_name {{ '}' }}{{ '}' }}
        run: |
          if ! echo "$HOST_NAME" | grep -Eq '^[a-zA-Z0-9._-]+$'; then
            echo "Error: Invalid host_name '$HOST_NAME'" >&2
            exit 1
          fi
          if [ -f "/tmp/{{ git_platform.repo_prefix }}-secrets/ssh-key/${HOST_NAME}.pub" ]; then
            cd /tmp/{{ git_platform.repo_prefix }}-secrets
            git rm -f "ssh-key/${HOST_NAME}.pub"
          fi

      - name: 提交刪除變更至 Secrets
        if: ${{ '{' }}{{ '{' }} inputs.purge_secrets == 'true' {{ '}' }}{{ '}' }}
        uses: ./.gitea/actions/git-sync-commit
        with:
          target_dir: '/tmp/{{ git_platform.repo_prefix }}-secrets'
          commit_msg: "feat(ssh): revoke and remove endpoint ${{ '{' }}{{ '{' }} inputs.host_name {{ '}' }}{{ '}' }}.pub"
          author_name: 'ci-bot'
          author_email: 'ci-bot@{{ cluster.domain }}'
