# ==============================================================================
# Master SSH Client Configuration (~/.ssh/config)
# Auto-generated by operations engine from site manifest & dynamic node facts
# ==============================================================================

# 1. Version Control & Git Forges
Host {{ git_platform.host }} {{ git_platform.ip }}
    HostName {{ git_platform.ip }}
    Port {{ git_platform.ssh_port }}
    User git
    IdentityFile ~/.ssh/{{ keys.git }}
    IdentityFile ~/.ssh/gitea.key
    IdentitiesOnly yes

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github.key
    IdentityFile ~/.ssh/{{ keys.git }}
    IdentitiesOnly yes

{%- if networks is defined and networks.gateway_ip is defined %}
# 2. Network Gateway
Host gw-node {{ networks.gateway_ip }}
    HostName {{ networks.gateway_ip }}
    User {{ cluster.admin_user }}
    IdentityFile ~/.ssh/{{ keys.user }}
    IdentityFile ~/.ssh/{{ keys.ansible }}
    IdentitiesOnly yes
{%- endif %}

{%- if nodes is defined and nodes %}
# 3. Dynamic Managed Nodes (conf/nodes/*.json)
{%- for n in nodes %}
Host {{ n.hostname }} {{ n.primary_ip }}
    HostName {{ n.primary_ip }}
    User {{ n.target_user if n.target_user is defined else cluster.ansible_user }}
    IdentityFile ~/.ssh/{{ keys.ansible }}
    IdentityFile ~/.ssh/{{ keys.user }}
    IdentitiesOnly yes
{%- endfor %}
{%- elif inventory is defined and inventory.servers is defined and inventory.servers.linux is defined %}
# 3. Managed Servers
{%- for h_name, h_info in inventory.servers.linux.hosts.items() %}
Host {{ h_name }} {{ h_info.ansible_host }}
    HostName {{ h_info.ansible_host }}
    User {{ cluster.admin_user }}
    IdentityFile ~/.ssh/{{ keys.user }}
    IdentityFile ~/.ssh/{{ keys.ansible }}
    IdentitiesOnly yes
{%- endfor %}
{%- endif %}

# 4. Global Defaults
Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
    AddKeysToAgent yes
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.ssh/known_hosts
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h:%p
    ControlPersist 10m
