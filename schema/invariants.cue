package schema

// OpenLabOps Operational & Architectural Invariants Specification
// [INV-01] ~ [INV-11] Hard Architectural Invariants
// Single Source of Truth (SSOT) for OpenLabOps open-source operations engine.

#Invariant: {
	id:          string & =~"^\\[INV-[0-9]{2}\\]$"
	name:        string
	strictness:  "NON-NEGOTIABLE" | "STRICT"
	description: string
	rules: [...string]
}

#InvariantsMatrix: {
	inv_01: #Invariant & {
		id:          "[INV-01]"
		name:        "Zero External Dependencies"
		strictness:  "NON-NEGOTIABLE"
		description: "Core CLI tools and Python engines must strictly use the standard library."
		rules: [
			"NO pip",
			"NO requests",
			"NO pyyaml",
			"NO paramiko",
			"100% Python 3 standard library only",
		]
	}

	inv_02: #Invariant & {
		id:          "[INV-02]"
		name:        "Zero Credentials in Repository & One-Way Key Distribution"
		strictness:  "NON-NEGOTIABLE"
		description: "Plaintext private keys and secrets must never be committed to repository. Private keys exist exclusively on dev nodes."
		rules: [
			"FORBIDDEN to commit *.key files to Git repositories",
			"Private keys (ansible.key, id_user.key) are strictly restricted to 'dev' console nodes (e.g. control workstation)",
			"Managed nodes (servers, desktops) must NEVER hold ansible.key; only authorized_keys public keys are provisioned",
			"Non-7/24 nodes (always_online: false) are STRICTLY FORBIDDEN from being classified as 'dev'",
			"All nodes synchronize public keys on boot or drift detection via Git SHA handshake with Gitea SSOT",
			"Ephemeral bootstrap keys stored in /tmp/ and purged after handover",
		]
	}

	inv_03: #Invariant & {
		id:          "[INV-03]"
		name:        "Three-Tier Separation & Template Compiler Architecture"
		strictness:  "NON-NEGOTIABLE"
		description: "Strict separation between immutable framework specs, user-defined site intents, and dynamic node telemetry."
		rules: [
			"Tier 1 (core): Immutable framework specification and neutral templates (conf/core.manifest.yml, templates/)",
			"Tier 2 (site): Site-specific cluster intent populated by lab-init (conf/openlab.manifest.yml)",
			"Tier 3 (node): Dynamic machine sensory facts collected into conf/nodes/*.json and compiled to inventory/hosts.yml",
			"Zero Static Config In Master: openlabops contains neutral roles, actions, and templates; concrete hosts/vars/workflows are generated by compiler app",
			"Template Rendering Engine: Fixed-syntax files (Ansible inventory/vars, Gitea workflows) must be rendered from templates via site parameters",
		]
	}

	inv_04: #Invariant & {
		id:          "[INV-04]"
		name:        "Sensory Ground Truth (Anti-Hallucination)"
		strictness:  "NON-NEGOTIABLE"
		description: "Dynamic telemetry must never be hardcoded into manifests or static specs."
		rules: [
			"Dynamic telemetry resides exclusively in conf/nodes/*.json",
			"Telemetry probed on-demand from live nodes via bootstrap_probe.sh / lab-discover",
			"Pure JSON Telemetry: Dynamic facts processed directly by Python stdlib into inventory without runtime CUE validation overhead",
		]
	}

	inv_05: #Invariant & {
		id:          "[INV-05]"
		name:        "Flat LAN Network Scope"
		strictness:  "NON-NEGOTIABLE"
		description: "Pre-configured for Flat LAN (192.168.1.0/24) with zero proprietary network dependencies."
		rules: [
			"flat_lan: 192.168.1.0/24",
			"Single flat subnet topology; no proprietary gateway or hardware router dependencies",
		]
	}

	inv_06: #Invariant & {
		id:          "[INV-06]"
		name:        "Centralized Documentation Hub"
		strictness:  "NON-NEGOTIABLE"
		description: "All human Markdown documentation must reside exclusively in docs/."
		rules: [
			"Categorized under docs/architecture/, docs/user_manual/, docs/ansible/, docs/tools/",
			"DO NOT create random markdown files in code directories",
		]
	}

	inv_07: #Invariant & {
		id:          "[INV-07]"
		name:        "Canonical Key Roles & Appliance Protocol Decoupling"
		strictness:  "NON-NEGOTIABLE"
		description: "Framework code uses 3 neutral canonical key roles (ansible, user, git); site binds physical key names."
		rules: [
			"Canonical key roles (ansible, user, git) formalized in schema/keys.cue and conf/core.manifest.yml",
			"Site cluster manifest maps canonical roles to site physical key names (e.g. ansible -> ansible.key, user -> id_user.key, git -> git.key)",
			"Workstations and desktops generate client keys dynamically by hostname ($hostname.key)",
		]
	}

	inv_08: #Invariant & {
		id:          "[INV-08]"
		name:        "Non-Destructive Safe Evolution"
		strictness:  "NON-NEGOTIABLE"
		description: "Active production repositories remain untouched as green baseline."
		rules: [
			"Preserves user configurations and maintains backward compatibility",
			"Sandbox tests executed on virtual networks, never modifying production hosts directly",
		]
	}

	inv_09: #Invariant & {
		id:          "[INV-09]"
		name:        "Production-Tool Verification (No Test-Only Artifacts)"
		strictness:  "NON-NEGOTIABLE"
		description: "Sandboxes and Dagger test suites must drive official production tools directly."
		rules: [
			"Dagger and containers exist solely to test if production tools can complete tasks",
			"STRICTLY FORBIDDEN to create mock-only bypass scripts or test-only tooling",
			"Sandbox tests must invoke bin/lab-init, bin/lab-node, engine/classifier.py directly",
		]
	}

	inv_10: #Invariant & {
		id:          "[INV-10]"
		name:        "Spec-First Three-Stage Pipeline"
		strictness:  "NON-NEGOTIABLE"
		description: "AI must align docs first, then update CUE/JSON schemas, and only then modify code."
		rules: [
			"Stage 1: Align documentation first",
			"Stage 2: Update schema/*.cue and conf/nodes/*.json and pass cue vet",
			"Stage 3: Modify code and pass unit + E2E tests",
		]
	}

	inv_11: #Invariant & {
		id:          "[INV-11]"
		name:        "Zero Repo Pollution & Ephemeral /tmp Workspace"
		strictness:  "NON-NEGOTIABLE"
		description: "All intermediate artifacts from test, install, or bootstrap actions must use /tmp and be cleaned up on exit."
		rules: [
			"All test, install, and bootstrap temporary files MUST reside under /tmp/",
			"All temporary directories and files MUST be purged upon completion via finally or trap EXIT",
			"Repository working tree must never be polluted by untracked test or install artifacts",
		]
	}
}

invariants: #InvariantsMatrix

